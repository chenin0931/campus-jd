{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "campus-jd company file",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "company",
      "title",
      "category",
      "city",
      "requirements",
      "deadline",
      "apply_url",
      "source_url",
      "fetched_at"
    ],
    "properties": {
      "company": {
        "type": "string",
        "description": "公司中文名，如 字节跳动；公司标识取自文件名"
      },
      "title": {
        "type": "string"
      },
      "category": {
        "enum": [
          "AI产品",
          "产品",
          "运营"
        ]
      },
      "city": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "requirements": {
        "type": "string"
      },
      "deadline": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "apply_url": {
        "type": "string",
        "format": "uri"
      },
      "source_url": {
        "type": "string",
        "format": "uri"
      },
      "fetched_at": {
        "type": "string",
        "format": "date-time"
      },
      "example": {
        "type": "boolean"
      },
      "job_type": {
        "enum": [
          "校招",
          "实习"
        ]
      },
      "type": {
        "enum": [
          "校招",
          "实习"
        ],
        "description": "job_type 的兼容别名"
      },
      "business_unit": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "事业群/业务线，可为空数组"
      },
      "project": {
        "type": [
          "string",
          "null"
        ],
        "description": "官网结构化招聘项目/批次名（飞书系 job_subject，如「2027届校园招聘」），无则 null"
      },
      "grad_year": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "integer"
        },
        "description": "build 时派生：届别，优先 project，其次正则；「及以后」追加下一年；抽不到 null"
      },
      "intern_duration": {
        "type": [
          "string",
          "null"
        ],
        "description": "build 时派生（仅实习）：如「≥3个月，每周≥4天」；抽不到 null"
      }
    }
  }
}